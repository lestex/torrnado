# Generated by contrib/homebrew/render.sh from the checksums a tag
# publishes, and written to the tap by the release workflow. Do not edit
# it there: the next release overwrites it.
class Torrnado < Formula
  desc "Terminal BitTorrent client with a vim-like interface and a background daemon"
  homepage "https://torrnado.dev/"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/lestex/torrnado/releases/download/v@VERSION@/torrnado_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/lestex/torrnado/releases/download/v@VERSION@/torrnado_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/lestex/torrnado/releases/download/v@VERSION@/torrnado_@VERSION@_linux_arm64.tar.gz"
      sha256 "@LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/lestex/torrnado/releases/download/v@VERSION@/torrnado_@VERSION@_linux_amd64.tar.gz"
      sha256 "@LINUX_AMD64@"
    end
  end

  def install
    bin.install "torrnado"
    man1.install "torrnado.1"
  end

  def caveats
    <<~EOS
      torrnado runs a background daemon that outlives the TUI. Run
        torrnado stop
      before `brew uninstall` or `brew upgrade`, or the old daemon keeps
      running from the removed binary.

      Uninstalling leaves your config and the daemon's state in place:
        ~/.config/torrnado
        ~/.local/share/torrnado
      Your downloads are never touched.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/torrnado version")
  end
end
